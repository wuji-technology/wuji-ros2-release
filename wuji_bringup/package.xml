<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wuji_bringup</name>
  <version>2026.10.26</version>
  <description>Launch integration for Wuji ROS 2 drivers and robot descriptions.</description>
  <maintainer email="support@wuji.tech">Wuji Technology</maintainer>
  <license>MIT</license>
  <url type="website">https://github.com/wuji-technology/wuji-ros2</url>
  <url type="repository">https://github.com/wuji-technology/wuji-ros2</url>
  <url type="bugtracker">https://github.com/wuji-technology/wuji-ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>wuji_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>wuji_hand2_1_description</exec_depend>
  <exec_depend>wuji_hand2_2_description</exec_depend>
  <exec_depend>wuji_hand2_driver</exec_depend>
  <exec_depend>wuji_glove_driver</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>ros2launch</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>tf2_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
